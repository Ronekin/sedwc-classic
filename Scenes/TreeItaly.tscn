[sub_resource type="Shader" id=5]
code = "shader_type canvas_item;

// Параметры эффекта
uniform float amplitude : hint_range(0.0, 50.0) = 10.0;   // амплитуда (пиксели)
uniform float frequency : hint_range(0.1, 5.0)  = 1.5;    // частота волн (Гц)
uniform float speed    : hint_range(0.0, 5.0)  = 1.0;    // скорость
uniform vec2 direction  = vec2(1.0, 0.5);      // направление волны
uniform float pivot_y  : hint_range(0.0, 1.0) = 0.3;   // точка опоры (0=низ, 1=верх)
uniform float falloff   : hint_range(0.0, 2.0) = 1.0;    // плавность перехода

void fragment() {
    vec2 uv = UV;
    float time = TIME;

    // Вычисляем базовое смещение (как раньше)
    float wave = sin(
        dot(uv * direction, vec2(1.0)) * frequency +
        time * speed
    ) * amplitude;

    // Модулируем смещение по вертикали:
    // - внизу (y < pivot_y) → смещение = 0
    // - вверху (y > pivot_y) → полное смещение
    float y_offset = pivot_y - uv.y;
    float strength = smoothstep(0.0, falloff, y_offset);

    // Применяем модулированное смещение
    vec2 offset_uv = uv + vec2(wave, wave) * SCREEN_PIXEL_SIZE * strength;

    // Получаем цвет с смещённых координат
    vec4 color = texture(TEXTURE, offset_uv);
    COLOR = color;
}

"

