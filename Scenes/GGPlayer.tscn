[sub_resource type="Shader" id=312]
code = "shader_type canvas_item;
 
uniform float width;
uniform vec4 outline_color : hint_color;
uniform vec4 aura_color : hint_color;
render_mode blend_mix;
 
void fragment()
{
    vec2 size = (vec2(width) * TEXTURE_PIXEL_SIZE);
   
    vec4 sprite_color = texture(TEXTURE, UV);
   
    float alpha = sprite_color.a;
    alpha += texture(TEXTURE, UV + vec2(0.0, -size.y)).a;
    alpha += texture(TEXTURE, UV + vec2(size.x, -size.y)).a;
    alpha += texture(TEXTURE, UV + vec2(size.x, 0.0)).a;
    alpha += texture(TEXTURE, UV + vec2(size.x, size.y)).a;
    alpha += texture(TEXTURE, UV + vec2(0.0, size.y)).a;
    alpha += texture(TEXTURE, UV + vec2(-size.x, size.y)).a;
    alpha += texture(TEXTURE, UV + vec2(-size.x, 0.0)).a;
    alpha += texture(TEXTURE, UV + vec2(-size.x, -size.y)).a;
    vec3 final_color = mix(outline_color.rgb, sprite_color.rgb, sprite_color.a );
	float alphaDa = clamp(alpha, 0.0, 1.0);
//	alphaDa += 0.2 ;
	if (texture(TEXTURE, UV).a >= 0.4) {
		final_color = aura_color.rgb;
		alphaDa = aura_color.a;
	}
		
   

	if (alphaDa == 0.0) {
		float i = 0.5 ;
		float da = 0.3 ;

		alphaDa += texture(TEXTURE, UV + vec2(0.0, -0.02) * i).a * da ;
		alphaDa += texture(TEXTURE, UV + vec2(0.0, 0.02) * i).a * da ;
		alphaDa += texture(TEXTURE, UV + vec2(-0.02, -0.02) * i).a * da ;
		alphaDa += texture(TEXTURE, UV + vec2(0.02, 0.02) * i).a * da ;
		alphaDa += texture(TEXTURE, UV + vec2(-0.02, 0.0) * i).a * da ;
		alphaDa += texture(TEXTURE, UV + vec2(0.02, 0.0) * i).a * da ;

	}








	vec4 orig = texture(SCREEN_TEXTURE, SCREEN_UV);
	float mited = (orig.x + orig.y + orig.z) / 3.0 ;
//	orig /= mited*0.9;
	if (alphaDa > 0.9) {
		mited = 0.0;
	}
	
    COLOR = vec4( (final_color*1.0* (1.0 - mited) + (orig.xyz*0.5 ))  ,alphaDa) ;
}"

[sub_resource type="ShaderMaterial" id=313]
