void fragment() {
	vec4 original_color = texture(TEXTURE, UV);
	vec4 white_color = vec4(1.0, 1.0, 1.0, original_color.a);
	vec4 final_color = mix(original_color, white_color, hit_opacity);



    COLOR = final_color;
		

	
}

"
