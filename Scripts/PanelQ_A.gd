# PanelQ_A.gd — кнопка вопроса и всплывающая подсказка Q&A.
#
# Текст вопроса задаётся в сцене/инспекторе, ответ — в General.qa_text.
# Не храните здесь игровое состояние.

extends TextureButton

export var text = ""
onready var panel_text = preload("res://Scenes/Q_Atext.tscn")

func _ready():
	$Label.text = text

