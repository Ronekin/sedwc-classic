[gd_resource type="Shader" format=2]

[resource]
code = "shader_type canvas_item;
render_mode unshaded;

void fragment() {
	vec4 c = textureLod(SCREEN_TEXTURE, SCREEN_UV, 0.0).rgba;
	if (((c.r < 0.2) && (c.b < 0.2) && (c.g < 0.2)) || c == vec4(1, 1, 1, 1) ) {
	c.r = 1.0;
	c.b = 1.0;
	c.g = 1.0;
	}
	else {
	c.r = 0.0;
	c.b = 0.0;
	c.g = 0.0; }
	COLOR.rgba = c;
}"
