[sub_resource type="Shader" id=13]
code = "shader_type canvas_item ;

uniform float pause : hint_range(0.1, 10.0, 0.1) = 1.0;
//render_mode blend_add;

void fragment() {
	vec4 pixel_color = texture(TEXTURE, UV);
	float luminance = dot(pixel_color.rgb, vec3(0.299, 0.587, 0.114));
	float time = (TIME * 0.2 / pause) + 0.5;
	vec4 color = pixel_color ;
//	float coord_da = ;
	if (time > 0.0) {
		time = time - float(int(time));
	}
	time = time*16.0*pause - 1.0 ;
	if (time > 1.0) {
		time = 99.0;
	}
	vec2 dist = abs(UV - vec2(time, time));
	float Distanc = sqrt((dist.x * dist.x + dist.y * dist.y));
//	bool da = fйe ;
	if (luminance > 0.4 ) {
//	if (luminance > 0.4 &&( ((abs(dist.x - dist.y) < 0.05 && abs(UV.x - UV.y) > 0.05)) || Distanc < 0.04) ) {
		if ( ( abs(UV.x-time - UV.y) < 0.05) ) {
			color *= 1.9 ;
//			da = true;
			}
	}
//	if (! da) {
//		color.a = 0.0
//	}
//	else {
//		COLOR = pixel_color
//	}
	COLOR = color;

}"

